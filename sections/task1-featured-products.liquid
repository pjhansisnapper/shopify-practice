<section>
  <h2>Featured Products</h2>
  <div class="Product-list">
    {% for product in collections['featured-products'].products %}
      <div class="product-item">
        <a href="{{ product.url }}">
            <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}" width="500" height="600">

          <h3>{{ product.title }}</h3>
        </a>
        <p>Price: {{ product.price | money }}</p>
      </div>
    {% else %}
      <li>No featured products available.</li>
    {% endfor %}
  </div>
   <!-- ✅ Add About Us Link Here -->
   <div class="about-us-link">
    <a href="{{ pages['about-us'].url }}">About Us</a>
  </div>
</section>
</section>
<style>
  .featured-products {
    text-align: center;
    padding: 20px;
  }

  .Product-list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px; /* Adds space between products */
    list-style: none;
    padding: 0;
  }

  .product-item {
    width: 300px; /* Adjust width for better spacing */
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    text-align: center;
    background-color: #f9f9f9;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
  }

  .product-item img {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
  }

  .product-item h3 {
    font-size: 18px;
    margin: 10px 0;
  }

  .product-item p {
    font-size: 16px;
    font-weight: bold;
    color: #333;
  }
</style>